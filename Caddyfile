# Reverse proxy Bailo — HTTPS automatique en production.
#
# En local, on écoute en HTTP sur :80. Pour un vrai domaine, remplacer `:80`
# par le nom de domaine (ex. `app.bailo.cm`) : Caddy obtient un certificat
# Let's Encrypt automatiquement (NF6 — HTTPS obligatoire).

:80 {
	# L'API sous /api/*.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Tout le reste : le front PWA (React) servi par nginx.
	handle {
		reverse_proxy web:80
	}

	encode gzip
}
