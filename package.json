{
  "name": "bailo",
  "private": true,
  "version": "0.1.0",
  "description": "Bailo — gestion locative pour cités et immeubles (MVP)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @bailo/api prisma:generate",
    "prisma:migrate": "pnpm --filter @bailo/api prisma:migrate",
    "seed": "pnpm --filter @bailo/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "globals": "^15",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  }
}
