{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      // Le monorepo héberge deux @types/react (web en 18, mobile en 19) ; pnpm peut
      // hisser la copie 18 dans son dossier de repli, où les .d.ts d'expo-router la
      // récupèrent, d'où un conflit de namespace JSX (bigint absent de ReactNode).
      // On épingle la résolution de « react » sur la copie 19 du mobile.
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"]
    }
  },
  "include": ["src"]
}
