# ─── Base de données ───────────────────────────────────────────────
DATABASE_URL="postgresql://bailo:bailo@localhost:5432/bailo?schema=public"

# ─── Redis / files de tâches (BullMQ) ──────────────────────────────
REDIS_URL="redis://localhost:6379"
ENABLE_JOBS=false                # true en prod : maintenance quotidienne (retards, relances, échéances)
JOBS_CRON="0 2 * * *"            # 02:00 Africa/Douala

# ─── API ───────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
TZ="Africa/Douala"

# ─── Auth ──────────────────────────────────────────────────────────
# ⚠️  SECRETS JWT — EN PRODUCTION, IMPÉRATIVEMENT générer via :
#     openssl rand -base64 48
#     ou  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#     Le validateur Zod rejette tout secret < 32 car ou contenant "change-me"/"dev-"/"secret".
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5

# Cookies — le refresh token est un cookie HttpOnly « bailo_rt » (Path=/api/v1/auth, sécurité 1.2)
COOKIE_SECRET=""                 # réservé (signature de cookies) ; en prod : openssl rand -base64 32
COOKIE_SECURE=false              # true en production (HTTPS requis)
COOKIE_SAMESITE="lax"            # lax (recommandé : front et API sur le même domaine) | strict | none (exige SECURE)

# ─── Fournisseur OTP / SMS ─────────────────────────────────────────
# console : factice (dev), INTERDIT en production — les OTP (reset mot de passe,
# signature de contrat) échouent tant qu'un vrai fournisseur n'est pas branché.
SMS_PROVIDER="console"        # console | africastalking
SMS_USERNAME=""               # Africa's Talking : nom d'application (« sandbox » = bac à sable)
SMS_API_KEY=""
SMS_SENDER_ID=""              # identifiant d'expéditeur validé (optionnel)

# ─── Stockage objet S3 / MinIO ─────────────────────────────────────
# Endpoint utilisé pour SIGNER les URLs : il doit être joignable par le NAVIGATEUR
# (c'est lui qui dépose/lit les fichiers), pas seulement par l'API. En Docker Compose,
# définir S3_PUBLIC_ENDPOINT sur l'URL publique de MinIO (sous-domaine, ou port 9000 publié).
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
# Endpoint joignable par le serveur (logo inliné sur les reçus PDF). En Docker : http://minio:9000.
S3_INTERNAL_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="bailo"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
FILE_SIGNED_URL_TTL_SECONDS=300

# ─── PDF & reçus ───────────────────────────────────────────────────
PDF_ENGINE="puppeteer"           # puppeteer (repli HTML si Chromium absent) | html
# Image Docker de l'API : build arg INSTALL_CHROMIUM=true pour embarquer Chromium.
# Base publique des liens de vérification de reçu (QR code) — F6.4
PUBLIC_RECEIPT_BASE="http://localhost:5173/r"

# ─── Monitoring des erreurs (6.4, optionnel) ───────────────────────
SENTRY_DSN=""                    # API — vide = désactivé
SENTRY_ENVIRONMENT="development"

# ─── Front (apps/web, préfixe VITE_) ───────────────────────────────
VITE_API_URL="http://localhost:3000/api/v1"
VITE_PUBLIC_RECEIPT_BASE="http://localhost:5173/r"
# Image Docker du front : true (défaut) = appels en relatif /api/v1, relayés par nginx
# vers l'origine de VITE_API_URL (ou API_UPSTREAM) → cookie de session first-party.
VITE_API_SAME_ORIGIN="false"
VITE_SENTRY_DSN=""               # front — vide = SDK Sentry jamais chargé
