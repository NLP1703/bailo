# ─── Base de données ───────────────────────────────────────────────
DATABASE_URL="postgresql://citegest:citegest@localhost:5432/citegest?schema=public"

# ─── Redis / files de tâches (BullMQ) ──────────────────────────────
REDIS_URL="redis://localhost:6379"
ENABLE_JOBS=false                # true en prod : maintenance quotidienne (retards, relances, échéances)
JOBS_CRON="0 2 * * *"            # 02:00 Africa/Douala

# ─── API ───────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
TZ="Africa/Douala"

# ─── Auth ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5

# ─── Fournisseur OTP / SMS (implémentation factice en dev) ─────────
SMS_PROVIDER="console"        # console | <fournisseur local>
SMS_API_KEY=""

# ─── Stockage objet S3 / MinIO ─────────────────────────────────────
# Endpoint utilisé pour SIGNER les URLs : il doit être joignable par le NAVIGATEUR
# (c'est lui qui dépose/lit les fichiers), pas seulement par l'API. En Docker Compose,
# définir S3_PUBLIC_ENDPOINT sur l'URL publique de MinIO (sous-domaine, ou port 9000 publié).
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
# Endpoint joignable par le serveur (logo inliné sur les reçus PDF). En Docker : http://minio:9000.
S3_INTERNAL_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="citegest"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
FILE_SIGNED_URL_TTL_SECONDS=300

# ─── PDF & reçus ───────────────────────────────────────────────────
PDF_ENGINE="puppeteer"           # puppeteer | (repli HTML si Chromium absent)
# Base publique des liens de vérification de reçu (QR code) — F6.4
PUBLIC_RECEIPT_BASE="http://localhost:5173/r"

# ─── Front (apps/web, préfixe VITE_) ───────────────────────────────
VITE_API_URL="http://localhost:3000/api/v1"
VITE_PUBLIC_RECEIPT_BASE="http://localhost:5173/r"
